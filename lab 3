<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Module 1 Exercise 3</title>

<style>
body {
    font-family: sans-serif;
    margin: 0;
}

.container {
    display: flex;
    min-height: 100vh;
    align-items: stretch;
}

.column {
    background: goldenrod;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex: 1;
}

.column img {
    width: 200px;
    height: 150px;
    object-fit: cover;
    margin-bottom: 20px;
}

button {
    background-color: #333;
    color: white;
    border: none;
    padding: 12px 24px;
    font-size: 16px;
    border-radius: 6px;
    cursor: pointer;
}

button:hover {
    background-color: #555;
}
</style>
</head>

<body>

<div class="container">

    <div class="column" id="column1">
        <h1 id="heading1">Hello</h1>

        <img src="https://picsum.photos/200/150?random=1" alt="Random image">

        <button onclick="changeColumn1()">Change Me</button>
    </div>

    <div class="column" id="column2">
        <h1 id="heading2">World</h1>

        <img src="https://picsum.photos/200/150?random=2" alt="Random image">

        <button onclick="changeColumn2()">Change Me</button>
    </div>

</div>

<script>
function changeColumn1() {
    document.getElementById("column1").style.backgroundColor = "lightblue";
    document.getElementById("heading1").textContent = "Hello Again!";
}

function changeColumn2() {
    document.getElementById("column2").style.backgroundColor = "lightgreen";
    document.getElementById("heading2").textContent = "World Again!";
}
</script>

</body>
</html>
